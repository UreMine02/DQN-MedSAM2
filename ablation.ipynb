    "    join_df = join_df[join_df[\"drop_frame_fifo\"] != -1]\n",
    "    join_df = join_df[(join_df['dice_diff'] > join_df['dice_diff'].quantile(0.9))]\n",
    "    \n",
    "    mean_delta[dataset+\"+FIFO\"] = join_df[\"drop_delta_fifo\"]\n",
    "    mean_delta[dataset+\"+AFS\"] = join_df[\"drop_delta_rl\"]"
