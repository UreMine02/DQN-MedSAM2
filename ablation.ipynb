    "})\n",
    "\n",
    "# 1. Setup synthetic data (simulating distributions around your previous means)\n",
    "np.random.seed(42)\n",
    "datasets = ['MSD-Heart', 'MSD-Lung', 'MSD-Spleen', 'Sarcoma']\n",
    "\n",
    "data = []\n",
    "# Means from your previous chart\n",
